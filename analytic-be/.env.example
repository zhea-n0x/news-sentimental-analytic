PORT=4000
# analytic-fe origin, allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# The local database: a mongoexport backup folder, read at startup (no MongoDB)
DB_SAMPLE_DIR=../db-sample
# Gemma's results, one JSON line per article (default: <DB_SAMPLE_DIR>/sentiments.jsonl)
# SENTIMENT_FILE=

# Sentiment analysis with Gemma via the Gemini API (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_BATCH_SIZE=10
GEMMA_RPM=15
GEMMA_EXCERPT_CHARS=700
# Newest unanalysed articles queued per filter request
ANALYSIS_QUEUE_LIMIT=100

# Scraper: writes new articles into the db-sample files. Off unless true
SCRAPE_INTO_DB_SAMPLE=false
# Cron expression for the scraper, evaluated in SCRAPE_TIMEZONE
SCRAPE_CRON="0 * * * *"
SCRAPE_TIMEZONE=Asia/Jakarta
# Run one scrape immediately when the server starts (only when SCRAPE_INTO_DB_SAMPLE=true)
SCRAPE_ON_START=true
# Also re-check the index for the previous N days (catches late-night headlines)
SCRAPE_LOOKBACK_DAYS=1
# Parallel article requests and pause between them, to stay polite to the portal
SCRAPE_CONCURRENCY=3
SCRAPE_DELAY_MS=500
