PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=news_sentiment

# Cron expression for the scraper, evaluated in SCRAPE_TIMEZONE
SCRAPE_CRON="0 * * * *"
SCRAPE_TIMEZONE=Asia/Jakarta
# Run one scrape immediately when the server starts
SCRAPE_ON_START=true
# Also re-check the index for the previous N days (catches late-night headlines)
SCRAPE_LOOKBACK_DAYS=1
# Parallel article requests and pause between them, to stay polite to the portal
SCRAPE_CONCURRENCY=3
SCRAPE_DELAY_MS=500
