PORT=4000
# analytic-fe origin, allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# The database: MongoDB first
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=news_sentiment
# How long to wait for MongoDB at startup before falling back to db-sample
MONGODB_CONNECT_TIMEOUT_MS=3000

# Fallback when MongoDB cannot be reached: a mongoexport backup folder, read at startup
DB_SAMPLE_DIR=../db-sample
# Gemma's results while on db-sample, one JSON line per article (default: <DB_SAMPLE_DIR>/sentiments.jsonl).
# With MongoDB, results from this file that are not in the database yet are imported at startup
# SENTIMENT_FILE=

# Sentiment analysis with Gemma: "ollama" (local, the default without an API key) or "gemini"
GEMMA_PROVIDER=ollama
# Ollama: run `ollama pull gemma4:e2b` and keep `ollama serve` running
OLLAMA_URL=http://localhost:11434
# Context window the model is loaded with; article text in a batch is trimmed to fit it
OLLAMA_NUM_CTX=16384
# Gemini API: key from https://aistudio.google.com/apikey, model e.g. gemma-4-26b-a4b-it
GEMINI_API_KEY=
GEMMA_MODEL=gemma4:e2b
# Articles per request (default 5 with Ollama, 10 with Gemini)
GEMMA_BATCH_SIZE=5
GEMMA_RPM=15
# Most characters of text per article (default 30000 with Ollama, i.e. whole articles; 700 with Gemini)
GEMMA_EXCERPT_CHARS=30000
# Newest unanalysed articles queued per filter request
ANALYSIS_QUEUE_LIMIT=100

# Scraper: writes new articles into MongoDB. On unless false
SCRAPE_ENABLED=true
# While on the db-sample fallback, scrape into its files. Off unless true
SCRAPE_INTO_DB_SAMPLE=false
# Cron expression for the scraper, evaluated in SCRAPE_TIMEZONE
SCRAPE_CRON="0 * * * *"
SCRAPE_TIMEZONE=Asia/Jakarta
# Run one scrape immediately when the server starts (when scraping is on)
SCRAPE_ON_START=true
# Also re-check the index for the previous N days (catches late-night headlines)
SCRAPE_LOOKBACK_DAYS=1
# Article pages fetched in parallel per portal
SCRAPE_CONCURRENCY=2
# Requests to one site are at least this far apart, plus a random 0..JITTER ms
# (a longer Crawl-delay in the site's robots.txt wins)
SCRAPE_REQUEST_INTERVAL_MS=1500
SCRAPE_REQUEST_JITTER_MS=1000
# Cron runs start each portal at a random moment within this many minutes
SCRAPE_START_JITTER_MINUTES=10
# Stop a portal's run after this many 403/429 responses in a row
SCRAPE_MAX_BLOCKED_RESPONSES=3
# User-Agent sent with every request; robots.txt rules are evaluated for it
# SCRAPE_USER_AGENT="NewsSentimentBot/1.0 (+mailto:you@example.com)"
