PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=news_sentiment

# Cron expression for the scraper, evaluated in SCRAPE_TIMEZONE
SCRAPE_CRON="0 * * * *"
SCRAPE_TIMEZONE=Asia/Jakarta
# Run one scrape immediately when the server starts
SCRAPE_ON_START=true
# Also re-check the index for the previous N days (catches late-night headlines)
SCRAPE_LOOKBACK_DAYS=1
# Article pages fetched in parallel per portal
SCRAPE_CONCURRENCY=2
# Requests to one site are at least this far apart, plus a random 0..JITTER ms
# (a longer Crawl-delay in the site's robots.txt wins)
SCRAPE_REQUEST_INTERVAL_MS=1500
SCRAPE_REQUEST_JITTER_MS=1000
# Cron runs start each portal at a random moment within this many minutes
SCRAPE_START_JITTER_MINUTES=10
# Stop a portal's run after this many 403/429 responses in a row
SCRAPE_MAX_BLOCKED_RESPONSES=3
# User-Agent sent with every request; robots.txt rules are evaluated for it
# SCRAPE_USER_AGENT="NewsSentimentBot/1.0 (+mailto:you@example.com)"
